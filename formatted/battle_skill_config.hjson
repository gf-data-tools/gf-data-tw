    buff_id_target: 8111:1,8116:1
    buff_id_self: 3533:1,3535:1,3536:1,3537:1,3572:1,1000:1
    description:
      '''
      被動:攻擊有15%的機率點燃怒火,持續3秒,持續時間內每次普攻將造成一次40%的額外傷害。
      主動:啟動白獒之瞳監視敵方全體,攻擊被監視的單位時提升自身25%火力,命中和暴擊率,被監視目標攻擊時提升自身25%閃避,監視持續6秒。技能持續時間內每兩秒增加自身五層負荷,場上的每組被監視單位每兩秒會增加自身一層負荷,達到18層時白獒之瞳效能下降並清除負荷層數,自身射速,命中下降20%,持續5秒,該減益可與監視增益共存,但效能下降持續時間內無法再次啟動白獒之瞳。
      '''
    lvup_description: 冷卻時間:10秒,屬性提升:25%,負荷上限:18
    data_pool_1: "180,190"
    data_pool_2: "125,125,125,125"
    code: AK15
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
