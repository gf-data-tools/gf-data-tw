  {
    id: 11960101
    name: 聖暉加冕
    skill_group_id: 119601
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 600
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 3490
    is_form_action: 1
    buff_id_self: 4852:1,4856:-999,1023:-100
    description:
      '''
      作戰開始時,使場上的偶數格子成為聖暉領域。若聖暉領域內存在友方單位,每秒為自身增加1點聖暉能量,多個單位可疊加,上限100點。
      友方位於聖暉領域內時,不會受到低於30點的偶數傷害。位於聖暉領域內的友方普攻時附帶餘火效果,額外造成100點固定傷害。
      主動:消耗所有聖暉能量,每消耗1點聖暉能量增加自身1點傷害值,該效果持續6秒。
      '''
    lvup_description: 冷卻時間:20秒,傷害增加:1點,持續時間:6秒
    data_pool_1: "180"
    data_pool_2: *2121
    code: SCAR_L
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
