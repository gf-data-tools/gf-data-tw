  {
    id: 90235601
    name: 謐亡碑文
    skill_group_id: 902356
    level: 1
    type: 1
    skill_priority: 7
    cd_type: 1
    cd_time: 600
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
    action_id: 5544
    is_form_action: 1
    buff_id_target: 7409:1,740904:1,740905:1
    buff_id_self: 740906:1
    buff_delay: 41
    description:
      '''
      被動:艾德琳造成的傷害均由受擊目標的各個編制平攤。當敵方單位身上同時存在黑色印記和白色印記時,會藉由在場的艾德琳引爆印記(黑白印記消去),造成1倍必中無視護甲的<color=#db3d3d>爆炸傷害</color>。
      主動:4秒的持續時間內,敵方的黑色印記不會因引爆而被消去,敵方全體命中和迴避降低10%。同時技能持續時間內優先攻擊敵方單編單位,每隔1秒瞄準時間造成1.6倍計算護甲的必中可暴擊傷害。
      '''
    lvup_description: 冷卻時間:20秒,爆炸倍率:1倍,屬性降低:10%,持續時間:4秒,狙擊傷害倍率:1.6倍
    data_pool_1: "120"
    data_pool_2: "90"
    code: NytoB1
    train_coin_type: 4
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
