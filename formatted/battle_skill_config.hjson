  {
    id: 11640101
    name: 小邪神飛踢
    skill_group_id: 116401
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 450
    start_cd_time: 150
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 4
    action_id: 3118
    buff_id_self: 4430:1,4431:1
    description:
      '''
      主動:小邪神飛踢!小邪神對血量最高敵方單位使出強力飛踢,期間獲得1.5秒無敵,對中心1.5範圍內的敵人造成2倍傷害,並對外圈4範圍內敵人造成最低0.6倍傷害,最高造成1.8倍傷害,中心範圍敵方越多傷害越高。
      被動:小邪神使用飛踢作為普通攻擊,對最近敵方單位造成1範圍計算迴避護甲的編制傷害。小邪神每隔10秒恢復自身已損失生命值10%的護盾。
      '''
    lvup_description: 冷卻時間:15秒,中心倍率:2倍,外圈最高倍率:1.8倍,外圈最低倍率:0.6倍
    data_pool_1: "1.5,4"
    data_pool_2: "200,*1735"
    code: jashinchan
    train_coin_type: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
