    name: 詛咒玩偶
    skill_group_id: 1007701
    level: 10
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 360
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 9260
    is_form_action: 1
    buff_id_target: 9886:1
    description:
      '''
      被動:若自身裝備了消音器進入戰鬥,則本場戰鬥自身受到迴避增益的技能(包含妖精詞綴)增益時,額外提升自身迴避20%,持續5秒,上限3層。(該增益不會觸發自身被動效果)
      主動:對自身和影響格單位造成一次50點傷害,然後降低敵方全體迴避90%,持續8秒。若該傷害導致了自身死亡,則額外降低敵方全體傷害和攻速50%,持續20秒。
      '''
    lvup_description: 冷卻時間:12秒,敵方迴避降低:90%,持續時間:8秒,敵方傷害和攻速降低:50%
    code: Maxim9Skill
    train_coin_type: 3
    train_coin_number: 300
    is_switch: 1
    skill_up_time: 36000
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
