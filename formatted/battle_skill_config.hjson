  {
    id: 75040901
    name: 潮音斬
    skill_group_id: 750409
    level: 1
    type: 1
    skill_priority: 7
    cd_type: 1
    cd_time: 450
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 8381
    buff_id_self: 8304:1,8305:1,8324:1,1000:1
    buff_delay: 41
    description:
      '''
      釋放技能對自身3範圍內的敵方單位造成1倍範圍編制傷害,並附加浪湧印記。持續期間普攻形態改變,對最近單位進行斬擊,技能持續8秒。
      每次斬擊時,帶浪湧印記的敵方單位同時受到額外0.7倍必中可暴擊的非編制傷害。
      技能結束時,隨機斬殺一個血量低於20%且被標記了浪湧印記的敵方單位,斬殺單位後暈眩2範圍內單位1秒。技能結束後,場上所有浪湧印記消失。
      '''
    lvup_description: 冷卻時間:15秒,範圍編制傷害倍率:1倍
    data_pool_1: "240"
    data_pool_2: "100"
    code: NytoWhiteSummer_1
    train_coin_type: 4
    target_lost: 2
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
