  {
    id: 75007501
    name: 冤大頭談判
    skill_group_id: 750075
    level: 1
    type: 1
    skill_priority: 5
    cd_type: 1
    cd_time: 240
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 623
    action_id: 400
    buff_id_target: 7712:1,7713:1
    buff_id_self: 7719:1,7721:1,1001:1,7724:1
    description:
      '''
      標記當前血量最高敵方單位並優先攻擊該目標3秒(存在boss時優先選擇boss),3秒內普攻可穿盾且必定命中和暴擊。
      3秒結束時,
      被標記的單位存在於場上:賦予被標記單位16%易傷,並附加嘲諷效果使我方集火該單位,效果持續3秒。
      被標記的單位死亡或消失:我方全體當前技能冷卻時間縮減16%。
      '''
    lvup_description: 易傷效果:16%,持續時間:3秒,我方全體冷卻縮減:16%
    data_pool_1: "180,90"
    code: SR2
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
