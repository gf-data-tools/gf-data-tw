  {
    id: 90229401
    name: 蜂鳥共鳴
    skill_group_id: 902294
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 450
    start_cd_time: 15
    trigger_id: "50113716"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 2
    action_id: 400
    is_form_action: 1
    buff_id_target: 719004:1000003935,719005:1000003936,719006:1000003937,1022:-9,1201:1000003935,1204:1000003936,1206:1000003937
    buff_id_self: 719007:1,719009:1
    description:
      '''
      被動:每間隔2秒獲得1隻蜂鳥,若開場同排如果沒有其他友方單位,可立刻獲得3隻蜂鳥,最多同時存在9隻蜂鳥。該單位每擁有一隻蜂鳥,自身攻擊附帶一次額外的1倍傷害。
      主動:消耗已有的全部蜂鳥賦予全隊增益效果,消耗1/2/3隻蜂鳥,全隊傷害提升5%/10%/15%;消耗4/5/6隻蜂鳥,在已有效果上提升全隊射速3%/5%/15%;消耗7/8/9隻蜂鳥,在已有效果上增加全隊暴擊率10%/25%/50%,持續5秒。效果持續期間將不會獲得蜂鳥。
      '''
    lvup_description: 冷卻時間:15秒,傷害提升:5%/10%/15%,射速提升:3%/5%/15%,暴擊率增加:10%/25%/50%,持續5秒
    data_pool_1: "150,148"
    data_pool_2: *393501,*393601,*393701
    code: Fbird
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
  {
    id: 90229402
    name: 蜂鳥共鳴
    skill_group_id: 902294
    level: 2
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 441
    start_cd_time: 15
    trigger_id: "50113716"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 2
    action_id: 400
    is_form_action: 1
    buff_id_target: 719004:1000003935,719005:1000003936,719006:1000003937,1022:-9,1201:1000003935,1204:1000003936,1206:1000003937
    buff_id_self: 719007:1,719009:1
