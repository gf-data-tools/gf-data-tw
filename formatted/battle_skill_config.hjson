  {
    id: 11560201
    name: 震盪裂轟
    skill_group_id: 115602
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 300
    start_cd_time: 120
    trigger_type: 6
    trigger_target: 1
    trigger_parameter: "1"
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    buff_id_self: 4156:1
    description:
      '''
      朝自身正前方5碼投擲手榴彈,對半徑2.5範圍內的敵人造成2倍的傷害,並造成3碼的擊飛效果。
      當自身位於中列時,往兩側擊飛敵人；當自身位於上/下列時,則將敵人擊飛至場中。擊飛效果對正在攻擊或正在釋放技能的單位無效。(裝備「SAF晶片」後,手榴彈傷害提升100%並且敵人被擊飛後還會暈眩3秒。)
      '''
    lvup_description: 冷卻時間:10秒,傷害倍率:2倍
    code: SAF
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
